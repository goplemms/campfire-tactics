{
  "name": "campfire-tactics",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "An isometric roguelike tactics game with non-combat jobs (cook, scout, merchant).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e-deploy-battle.mjs",
    "test:e2e:scenario": "node scripts/e2e-scenario.mjs",
    "test:e2e:arc": "node scripts/e2e-arc-events.mjs",
    "shots": "node scripts/shots-overworld.mjs",
    "shots:mill": "node scripts/shots-hollow-mill.mjs",
    "shots:dossier": "node scripts/shots-dossier.mjs",
    "shots:inventory": "node scripts/shots-inventory.mjs",
    "shots:discard": "node scripts/shots-discard.mjs",
    "shots:traveler": "node scripts/shots-traveler-gift.mjs",
    "shots:guild": "node scripts/shots-guild.mjs",
    "shots:deploy": "node scripts/shots-deploy.mjs",
    "shots:arrivals": "node scripts/shots-arrivals.mjs",
    "shots:telegraph": "node scripts/shots-telegraph.mjs",
    "shots:actions": "node scripts/shots-actions.mjs",
    "sim": "vitest run src/core/sim.test.ts",
    "validate": "vitest run src/core/feasibility.report.test.ts",
    "verify": "npm run test && npm run build && npm run shots:mill"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "puppeteer-core": "^25.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
